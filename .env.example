# Variables de entorno de la función /api/informe (anexo, sección 11).
# En producción se definen en Netlify. Aquí solo van los nombres, sin valores.
# Para pruebas locales sin enviar correos: copie este fichero a .env (no se sube a git)
# y ponga DELIVERY_MODE=download.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
AUTHOR_EMAIL=
CONTACT_EMAIL=
WHITEBOOK_URL=
SITE_URL=
SITE_HOST=
BREVO_LIST_ID=
DELIVERY_MODE=
