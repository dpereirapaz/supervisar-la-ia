{
  "name": "supervisar-la-ia",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio estático del whitebook «Supervisión de la IA»",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "check:html": "html-validate index.html 404.html autoevaluacion/index.html whitebook/index.html gracias/index.html error/index.html privacidad/index.html cookies/index.html aviso-legal/index.html",
    "check:lighthouse": "node scripts/lighthouse.mjs",
    "render:social": "node social/render.mjs",
    "test": "node report/scripts/test-engine.mjs && node --test test/funcion.test.mjs",
    "muestras": "node report/scripts/make-samples.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "html-validate": "^11.16.1",
    "lighthouse": "^13.5.0",
    "netlify-cli": "^27.11.0",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}
